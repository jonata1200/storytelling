APP_NAME=Storytelling
APP_ENV=local
APP_DEBUG=true
APP_SECRET_KEY=change-me-in-development

DATABASE_URL=postgresql+asyncpg://storytelling:storytelling@localhost:5432/storytelling
REDIS_URL=redis://localhost:6379/0

STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage
MAX_UPLOAD_BYTES=26214400
MAX_GENERATED_ASSET_BYTES=786432000
ALLOW_USER_REGISTRATION=true
SINGLE_USER_MODE=true

# Texto pode usar Ollama Cloud, Ollama local, Groq ou NVIDIA NIM por API.
# Veo AI Free e experimental para imagem/video e pode ser desabilitado.
# Modelos com sufixo :free e modelos mock-* sao bloqueados pela aplicacao.
# As chaves tambem podem ser salvas pela tela de Configuracoes de IA.
AI_PROVIDER=ollama
TEXT_PROVIDER=ollama
TEXT_PROVIDER_FALLBACKS=nvidia_nim,ollama
IMAGE_PROVIDER=veo_ai_free
VIDEO_PROVIDER=veo_ai_free

# Ollama Cloud: usa https://ollama.com/api/chat e exige OLLAMA_API_KEY.
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_DEFAULT_MODEL=gpt-oss:120b

# Ollama local: descomente se quiser usar um modelo instalado na maquina.
# OLLAMA_API_KEY=ollama
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_DEFAULT_MODEL=gpt-oss:20b

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_DEFAULT_MODEL=openai/gpt-oss-120b

NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_DEFAULT_MODEL=nvidia/nemotron-3-super-120b-a12b

VEO_AI_FREE_ENABLED=false
VEO_AI_FREE_SESSION_PATH=.runtime/veo_free/session.json
VEO_AI_FREE_IMAGE_MODEL=veo-ai-free/image
VEO_AI_FREE_VIDEO_MODEL=veo-ai-free/video

SPEECH_PROVIDER=openai_compatible
SPEECH_BASE_URL=https://api.openai.com/v1
SPEECH_API_KEY=
SPEECH_MODEL=
SPEECH_VOICE=alloy
SPEECH_TIMEOUT_SECONDS=120

USER_DISPLAY_NAME=Jonata
USER_EMAIL=
USER_AVATAR_PATH=
USER_THEME=dark
