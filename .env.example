APP_NAME=Storytelling
APP_ENV=local
APP_DEBUG=true
APP_SECRET_KEY=change-me-in-development

DATABASE_URL=postgresql+asyncpg://storytelling:storytelling@localhost:5432/storytelling
REDIS_URL=redis://localhost:6379/0

STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage
MAX_UPLOAD_BYTES=26214400
MAX_GENERATED_ASSET_BYTES=786432000
ALLOW_USER_REGISTRATION=true
SINGLE_USER_MODE=true

# Texto usa Ollama Cloud por API.
# Imagem e video usam Google AI.
# Voz e dublagem final usam ElevenLabs.
# Modelos com sufixo :free e modelos mock-* sao bloqueados pela aplicacao.
# As chaves tambem podem ser salvas pela tela de Configuracoes de IA.
AI_PROVIDER=ollama_cloud
TEXT_PROVIDER=ollama_cloud
TEXT_PROVIDER_FALLBACKS=
IMAGE_PROVIDER=google_ai
VIDEO_PROVIDER=google_ai

OLLAMA_CLOUD_API_KEY=
OLLAMA_CLOUD_BASE_URL=https://ollama.com/api
OLLAMA_CLOUD_DEFAULT_MODEL=deepseek-v4-flash:cloud

GOOGLE_AI_API_KEY=
GOOGLE_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GOOGLE_AI_IMAGE_MODEL=gemini-3.1-flash-lite-image
GOOGLE_AI_IMAGE_SIZE=1K
GOOGLE_AI_VIDEO_MODEL=veo-3.1-fast-generate-preview
GOOGLE_AI_VIDEO_FAST_MODEL=veo-3.1-fast-generate-preview
GOOGLE_AI_VIDEO_DEFAULT_DURATION_SECONDS=8
GOOGLE_AI_VIDEO_POLL_INTERVAL_SECONDS=10
GOOGLE_AI_VIDEO_POLL_TIMEOUT_SECONDS=900

SPEECH_PROVIDER=elevenlabs
SPEECH_BASE_URL=https://api.openai.com/v1
SPEECH_API_KEY=
SPEECH_MODEL=
SPEECH_VOICE=alloy
SPEECH_TIMEOUT_SECONDS=120

ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1
ELEVENLABS_VOICE_ID=
ELEVENLABS_SPEECH_MODEL=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

DUBBING_PROVIDER=elevenlabs
DUBBING_SOURCE_LANG=pt
DUBBING_TARGET_LANG=en
DUBBING_POLL_INTERVAL_SECONDS=10
DUBBING_POLL_TIMEOUT_SECONDS=900

USER_DISPLAY_NAME=Jonata
USER_EMAIL=
USER_AVATAR_PATH=
USER_THEME=dark
