APP_NAME=Storytelling
APP_ENV=local
APP_DEBUG=true
APP_SECRET_KEY=change-me-in-development

API_BASIC_USERNAME=admin
API_BASIC_PASSWORD=admin

DATABASE_URL=postgresql+asyncpg://storytelling:storytelling@localhost:5432/storytelling
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage

# OpenRouter, opcional. Sem chave, a aplicacao usa providers mockados.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://127.0.0.1:8000
OPENROUTER_APP_TITLE=Storytelling
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image
OPENROUTER_VIDEO_MODEL=google/veo-3.1

USER_DISPLAY_NAME=Jonata
USER_EMAIL=
USER_AVATAR_PATH=
USER_THEME=dark
