APP_NAME=Storytelling
APP_ENV=local
APP_DEBUG=true
APP_SECRET_KEY=change-me-in-development
# Token de autenticação para endpoints privados. Em ambientes não-locais
# a aplicação recusa iniciar sem ele; em local, deixar vazio desativa a auth.
APP_API_TOKEN=

# POSTGRES_* e REDIS_* sao usadas somente pelo docker-compose.yml para o
# mapeamento de portas dos containers; a aplicacao le DATABASE_URL/REDIS_URL.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
DATABASE_URL=postgresql+asyncpg://storytelling:storytelling@localhost:5433/storytelling
REDIS_URL=redis://localhost:6379/0
WORKER_QUEUE_NAME=storytelling:media-jobs
WORKER_CONSUMER_GROUP=storytelling-workers
WORKER_HEARTBEAT_SECONDS=10
WORKER_RECLAIM_SECONDS=120
WORKER_VIBES_CONCURRENCY=1
WORKER_META_IMAGE_CONCURRENCY=2
SHOT_AUTO_REGENERATION_ENABLED=true
SHOT_AUTO_REGENERATION_MAX_ATTEMPTS=2

STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage
MAX_GENERATED_ASSET_BYTES=786432000

# Texto e QA usam a API oficial do Ollama Cloud.
# Modelos com sufixo :free e modelos mock-* sao bloqueados pela aplicacao.
# As chaves tambem podem ser salvas pela tela de Configuracoes de IA.
# NOTA: os providers ativos sao fixos por decisao de produto (cutover):
# text=ollama_cloud, image=meta, video=vibes. Os valores TEXT_PROVIDER,
# IMAGE_PROVIDER e VIDEO_PROVIDER abaixo sao ignorados pelo Settings.
TEXT_PROVIDER=ollama_cloud
IMAGE_PROVIDER=meta
OLLAMA_CLOUD_INTEGRATION_MODE=api
OLLAMA_API_KEY=
OLLAMA_CLOUD_BASE_URL=https://ollama.com/api
OLLAMA_CLOUD_DEFAULT_MODEL=gemma4:31b-cloud
OLLAMA_CLOUD_VISION_MODEL=gemma4:31b-cloud
META_IMAGE_INTEGRATION_MODE=browser
META_IMAGE_MODEL=muse-image
META_BROWSER_PROFILE_PATH=./runtime/browser_profiles/meta
META_BROWSER_AUTOMATION_ENABLED=false

VIDEO_PROVIDER=vibes
VIBES_INTEGRATION_MODE=browser
VIBES_VIDEO_MODEL=vibes
VIBES_BROWSER_PROFILE_PATH=./runtime/browser_profiles/vibes
VIBES_BROWSER_AUTOMATION_ENABLED=false
# O perfil guarda somente sessão local autorizada e deve permanecer fora do Git.
FFMPEG_PATH=

USER_THEME=dark
