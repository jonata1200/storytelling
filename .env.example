APP_NAME=Storytelling
APP_ENV=local
APP_DEBUG=true
APP_SECRET_KEY=change-me-in-development

DATABASE_URL=postgresql+asyncpg://storytelling:storytelling@localhost:5432/storytelling
REDIS_URL=redis://localhost:6379/0

STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage
MAX_UPLOAD_BYTES=26214400
MAX_GENERATED_ASSET_BYTES=786432000
ALLOW_USER_REGISTRATION=true
SINGLE_USER_MODE=true

# Texto usa NVIDIA NIM por API.
# Para Ollama Cloud, use TEXT_PROVIDER=ollama_cloud e configure OLLAMA_CLOUD_API_KEY.
# Imagem e video usam Veo AI Free experimental.
# Modelos com sufixo :free e modelos mock-* sao bloqueados pela aplicacao.
# As chaves tambem podem ser salvas pela tela de Configuracoes de IA.
AI_PROVIDER=ollama_cloud
TEXT_PROVIDER=ollama_cloud
TEXT_PROVIDER_FALLBACKS=nvidia_nim
IMAGE_PROVIDER=veo_ai_free
VIDEO_PROVIDER=veo_ai_free

NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_DEFAULT_MODEL=z-ai/glm-5.2

OLLAMA_CLOUD_API_KEY=
OLLAMA_CLOUD_BASE_URL=https://ollama.com/api
OLLAMA_CLOUD_DEFAULT_MODEL=gpt-oss:120b

VEO_AI_FREE_ENABLED=false
VEO_AI_FREE_SESSION_PATH=.runtime/veo_free/session.json
VEO_AI_FREE_IMAGE_MODEL=veo-ai-free/image
VEO_AI_FREE_VIDEO_MODEL=veo-ai-free/video

SPEECH_PROVIDER=openai_compatible
SPEECH_BASE_URL=https://api.openai.com/v1
SPEECH_API_KEY=
SPEECH_MODEL=
SPEECH_VOICE=alloy
SPEECH_TIMEOUT_SECONDS=120

USER_DISPLAY_NAME=Jonata
USER_EMAIL=
USER_AVATAR_PATH=
USER_THEME=dark
