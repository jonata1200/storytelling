APP_NAME=Storytelling
APP_ENV=local
APP_DEBUG=true
APP_SECRET_KEY=change-me-in-development

DATABASE_URL=postgresql+asyncpg://storytelling:storytelling@localhost:5432/storytelling
REDIS_URL=redis://localhost:6379/0

STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage
MAX_UPLOAD_BYTES=26214400
MAX_GENERATED_ASSET_BYTES=786432000
ALLOW_USER_REGISTRATION=true
SINGLE_USER_MODE=true

# Texto pode usar Ollama, Groq ou NVIDIA NIM via API OpenAI-compatible.
# OmniRoute permanece como legado para imagem/video ate a migracao do Veo AI Free.
# Modelos com sufixo :free e modelos mock-* sao bloqueados pela aplicacao.
# As chaves tambem podem ser salvas pela tela de Configuracoes de IA.
AI_PROVIDER=omniroute
TEXT_PROVIDER=groq
TEXT_PROVIDER_FALLBACKS=
IMAGE_PROVIDER=omniroute
VIDEO_PROVIDER=omniroute

OLLAMA_API_KEY=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_DEFAULT_MODEL=llama3.1:8b

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile

NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_DEFAULT_MODEL=openai/gpt-oss-20b

OMNIROUTE_API_KEY=
OMNIROUTE_BASE_URL=https://omnirouters.com/v1
OMNIROUTE_DEFAULT_MODEL=opencode-zen/deepseek-v4-flash
OMNIROUTE_IMAGE_MODEL=chatgpt-web/gpt-5.5
OMNIROUTE_VIDEO_MODEL=veo-free/veo
OMNIROUTE_SPEECH_MODEL=
OMNIROUTE_IMAGE_TIMEOUT_SECONDS=360

SPEECH_PROVIDER=openai_compatible
SPEECH_BASE_URL=https://api.openai.com/v1
SPEECH_API_KEY=
SPEECH_MODEL=
SPEECH_VOICE=alloy
SPEECH_TIMEOUT_SECONDS=120

USER_DISPLAY_NAME=Jonata
USER_EMAIL=
USER_AVATAR_PATH=
USER_THEME=dark
